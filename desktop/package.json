{
  "name": "dingdong-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "咚咚绿色版桌面客户端：离线加载 P2P 聊天网页，解压即用。",
  "author": "Dan-k391",
  "contributors": ["ZJJ-2785", "naitunai"],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync-app": "node sync-app.js",
    "prebuild": "node sync-app.js",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.dank391.dingdong",
    "productName": "DingDong",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "assets/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "artifactName": "DingDong-Windows.${ext}"
  }
}
